{
	"$schema": "https://turborepo.org/schema.json",
	"globalDependencies": [".env", ".env.local"],
	"tasks": {
		"build": {
			"outputs": ["dist/**", ".next/**", "public/dist/**", ".parcel-cache/**"],
			"dependsOn": ["^build"]
		},
		"test": {
			"outputs": ["coverage/**"],
			"dependsOn": ["^build"]
		},
		"lint": {
			"outputs": []
		},
		"types": {
			"outputs": []
		},
		"dev": {
			"dependsOn": ["^db:generate"],
			"cache": false
		},
		"clean": {
			"cache": false
		},
		"db:generate": {
			"cache": false
		},
		"db:push": {
			"cache": false
		}
	}
}
