{
	"compilerOptions": {
		"outDir": "dist",
		"module": "esnext",
		"target": "esnext",
		"lib": ["ES2022"],
		"sourceMap": true,
		"allowJs": false,
		"declaration": true,
		"esModuleInterop": true,
		"moduleResolution": "node",
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"isolatedModules": true
	},
	"include": ["src/**/*", "types/*"],
	"exclude": ["node_modules"]
}
